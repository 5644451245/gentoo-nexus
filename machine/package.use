# gentoo-nexus consumer package.use — drop-in for /etc/portage/package.use/
#
# THIS FILE MUST MIRROR THE BUILDER'S package.use EXACTLY
# (.github/workflows/build.yml: "nexus" base block + "gaming" block).
# Portage matches binpkgs under the default --binpkg-respect-use=y: any flag
# delta between consumer and builder REJECTS the prebuilt binary and forces a
# source build (verified 2026-08-22 in clean stage3). Keep in sync.
#
# dev-lang/rust(-bin) abi_x86_32 are intentionally NOT here: they are not in
# the rolling binhost, so requiring their 32-bit variant would force a huge
# local build against the official v3 host. Steam users get them via the
# optional steam block in setup/quickstart.sh.
#
# VIDEO_CARDS reset MUST live here (package.use), NOT in make.conf.
# Portage rejects the '-*' operator in make.conf's VIDEO_CARDS line.
# Pure-AMD (Ryzen APU / discrete). Matches nexus builder so prebuilt mesa reused.
*/* VIDEO_CARDS: -* amdgpu radeonsi

# --- builder base block ---
media-libs/opus abi_x86_64 abi_x86_32
gui-libs/gtk introspection
sys-auth/seatd server
sys-kernel/installkernel dracut grub
sys-kernel/linux-firmware redistributable initramfs
sys-libs/minizip-ng compat
sys-apps/dbus -systemd elogind
media-video/pipewire -systemd elogind -ffmpeg
dev-libs/libdbusmenu gtk3
net-misc/networkmanager bluetooth -modemmanager
sys-libs/zlib-ng -abi_x86_32 abi_x86_64 compat
x11-libs/libdrm video_cards_amdgpu video_cards_radeon
media-libs/mesa -rust -opencl proprietary-codecs sysprof
media-video/ffmpeg x264 x265 vpx opus dav1d vaapi vdpau

# --- builder gaming/multilib block ---
media-libs/freetype brotli harfbuzz
sys-libs/glibc hash-sysv-compat

# --- binpkg USE-parity pins (2026-08-22) ---
# The binhosts (nexus rolling AND gentoo-official-v3) built these packages with
# flags that later flipped default in ::gentoo profiles. Explicit pins keep the
# consumer's effective USE identical to the shipped binaries so
# --binpkg-respect-use=y accepts them (otherwise every consumer recompiles).
dev-libs/glib sysprof
x11-libs/pango sysprof
media-video/pipewire gstreamer
# -gpm (2026-08-24): ncurses[gpm] + gpm form a mutual runtime dep that
# binary-only transactions cannot order. Both binhosts now ship ncurses with
# -gpm exactly like the official Gentoo v3 host; this pin keeps the consumer's
# effective USE aligned so the binary is accepted and the cycle cannot occur.
sys-libs/ncurses -gpm
# No abi_x86_32 request for ncurses/gpm (2026-08-24): no binhost ships 32-bit
# twins of this pair, and requesting them force-reinstalls the poisoned +gpm
# nexus builds whose mutual runtime deps deadlock binary-only transactions.
# Nothing in the desktop stack needs 32-bit libncurses/libgpm (wine/steam
# bundle their own); the official v3 pair is consumed as-is.
dev-vcs/git keyring
# libxmlb introspection pin removed 2026-08-24: rolling release does not ship
# libxmlb and the official v3 binary is built without it - the pin forced a
# source build for every consumer (appstream dep of protonplus).
x11-libs/gtk+ colord sysprof
